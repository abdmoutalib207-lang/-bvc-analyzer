# BVC Pipeline v9.0 — Variables d'environnement optionnelles
# Copier vers .env et remplir les valeurs

# Proxy HTTP si besoin (optionnel)
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128

# Timeout réseau en secondes (défaut: 15)
# PIPELINE_TIMEOUT=15

# Nombre de workers parallèles (défaut: 3)
# PIPELINE_WORKERS=3

# Niveau de log: DEBUG, INFO, WARNING, ERROR (défaut: INFO)
# LOG_LEVEL=INFO
